<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         MODAL: ASIGNAR LOTE POR UNIDAD (PrintFlow · §3.O)
         Lo abre el botón de ACCIÓN SOBRE LA SELECCIÓN "Asignar lote" de la
         bandeja de lote (``printflow.flow.lot.tray``).

         UNA sola decisión: cada fila es un MOVIMIENTO (una unidad / línea de
         pedido) de la entrega y lleva SU PROPIO selector de lote. El operador
         decide el par caja ↔ orden/unidad en una sola pasada (H-039/H-040).
         La tabla de candidatos es INFORMATIVA: no se marca nada allí.

         La escritura es la vía NATIVA (reserva, aditiva: una liberación + N
         reservas) por el orquestador del motor, sin tocar inventario a mano.
         Requiere jefe de taller/administrador (guardia en
         ``_pf_assert_can_clean``).
         ================================================================== -->
    <record id="printflow_flow_lot_assign_bulk_view_form" model="ir.ui.view">
        <field name="name">printflow.flow.lot.assign.bulk.form</field>
        <field name="model">printflow.flow.lot.assign.bulk</field>
        <field name="arch" type="xml">
            <!-- NO se pone edit="false": esta superficie ES una decisión (el
                 operador elige un lote por fila y escribe el motivo); con
                 edit="false" Odoo 17 abriría el registro en mode="readonly" y
                 NINGÚN campo se podría usar. -->
            <form string="Asignar lote en bloque" create="false" delete="false">
                <!-- Campos técnicos: alimentan el dominio del selector POR FILA
                     y el aviso de disponibilidad AGREGADA. -->
                <field name="candidate_lot_ids" invisible="1"/>
                <field name="multi_location" invisible="1"/>

                <!-- Cabecera COMPACTA (T8 · D-7): solo los datos que el operador
                     necesita para decidir. Los conteos ya van rotulados al lado,
                     así que la prosa que los repetía sobra. -->
                <!-- T12-e: DOS grupos ANIDADOS (forma de §3.O; el grupo externo
                     es `OuterGroup` y da 2 columnas desde 992 px, abajo apila:
                     es responsivo, no un defecto). El grupo plano de T12-a no
                     compró nada medible y quitó la 2ª columna ⇒ se revierte. -->
                <group string="Selección">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <!-- Queda en el registro pero NO se pinta (D-7). -->
                        <field name="source_label" readonly="1" invisible="1"/>
                        <!-- T2 (§3.Q · H-054): los dos conteos salen
                             INTERCAMBIADOS respecto de §3.P para que la fila 2
                             lea "por asignar | a entregar". NO reordenar. -->
                        <field name="assignable_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="location_id" readonly="1"/>
                        <field name="total_demand" readonly="1"/>
                        <field name="candidate_count" readonly="1"/>
                        <!-- Se pinta SOLO cuando hay filas omitidas (D-7). -->
                        <field name="omitted_count" readonly="1"
                               invisible="omitted_count == 0"/>
                    </group>
                    <!-- Texto VISIBLE (no tooltip): declara QUÉ es cada ranura
                         (una UNIDAD = un movimiento; la demanda va en UNIDADES),
                         sin repetir los conteos (H-031/H-047). `colspan="2"` en
                         un grupo externo = hijo sin clase de columna ⇒
                         `width: 100 %` (Bootstrap `.row > *`): línea propia a
                         ANCHO COMPLETO de la cabecera (T12-e). -->
                    <field name="selection_note" readonly="1"
                           nolabel="1" colspan="2"/>
                </group>

                <!-- Aviso VISIBLE: sin una única ubicación efectiva la
                     disponibilidad mostrada es AGREGADA (suma de todas las
                     ubicaciones). La reserva real la decide cada unidad con las
                     reglas NATIVAS de Odoo al asignar. -->
                <div class="alert alert-warning" colspan="2"
                     invisible="not multi_location">
                    Las unidades NO comparten una única ubicación: el lote muestra
                    su disponibilidad <b>AGREGADA</b> (suma de todas las
                    ubicaciones). La reserva real la decide cada unidad al
                    asignar; la que no alcance queda parcial u omitida.
                </div>

                <!-- T12-b (H-050): la prosa va FUERA del `<group>` (Odoo 17 la
                     metería como celda de la rejilla ⇒ tira vertical ilegible);
                     a ancho completo, como el aviso de arriba. -->
                <!-- T12-c (H-049): qué es una fila ya lo dice `selection_note`. -->
                <div class="text-muted">
                    Elige el lote de CADA unidad.
                </div>

                <!-- T12-f (CA-13): `colspan="2"` ⇒ la celda recibe
                     `grid-column: span 2` (`form_group.xml` L29) y ocupa las DOS
                     pistas del `InnerGroup` en vez de la de valor; y sin `col="1"`
                     el ancho relativo sale con maxCols=2 (100 %, no 200 %). La
                     tabla usa así el ancho completo del modal. Columnas intactas. -->
                <group string="Unidades de la entrega">
                    <!-- Fila de UNIDADES (T10 · CA-7): a la vista y en este orden
                         # · Entrega · Pedido · Lote propio · Existencia · Lote a
                         asignar. Lo demás queda recuperable por el operador
                         (optional="hide"), nunca borrado del modelo. -->
                    <field name="line_ids" nolabel="1" colspan="2">
                        <tree create="false" delete="false" editable="bottom"
                              decoration-success="result == 'assigned'"
                              decoration-warning="result == 'partial'"
                              decoration-muted="result == 'skipped'"
                              decoration-danger="result == 'error'">
                            <field name="seq" string="#"/>
                            <field name="label" string="Entrega"/>
                            <field name="sale_order_name" string="Pedido"/>
                            <field name="own_lot_name" string="Lote propio"/>
                            <field name="own_lot_qty" string="Existencia"/>
                            <field name="lot_id" string="Lote a asignar"
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="not assignable"/>
                            <!-- Fuera de la vista por defecto (T10 · CA-7).
                                 ``move_id`` empujaba fuera la columna que
                                 decide (H-046). -->
                            <field name="sale_line_id" string="Línea de pedido"
                                   optional="hide"/>
                            <field name="move_id" string="Unidad"
                                   optional="hide"/>
                            <field name="demand_qty" string="Demanda"
                                   optional="hide"/>
                            <field name="result" string="Resultado"
                                   optional="hide"/>
                            <field name="result_note" string="Nota"
                                   optional="hide"/>
                            <field name="kind" column_invisible="True"/>
                            <field name="res_model" column_invisible="True"/>
                            <field name="res_id" column_invisible="True"/>
                            <field name="assignable" column_invisible="True"/>
                            <field name="location_id" column_invisible="True"/>
                            <!-- Campo TÉCNICO OBLIGATORIO (no es una columna):
                                 el dominio del selector por fila
                                 (``printflow.flow.lot.assign.bulk.line.lot_id``)
                                 cita ``own_lot_id`` para NO ofrecer el lote propio
                                 de la unidad (candado de dominio, D-3). El
                                 validador de vistas de Odoo 17 exige que TODO
                                 nombre de campo citado en un dominio esté
                                 presente en la vista (``must_have_fields``): sin
                                 este nodo el módulo NO carga. NO quitar. -->
                            <field name="own_lot_id" column_invisible="True"/>
                        </tree>
                    </field>
                </group>

                <!-- SIEMPRE VISIBLE (T9 · D-6): es la "memoria" de la decisión.
                     4 columnas: Lote · Existencia · Disponible aquí · Rol. -->
                <!-- T12-b (H-050): prosa fuera del grupo ⇒ ancho completo. -->
                <div class="text-muted">
                    Informativo: lotes con existencia del producto. La decisión
                    se toma arriba, en cada unidad.
                </div>

                <!-- T12-f (CA-13): misma vía que la tabla de unidades. -->
                <group string="Lotes con existencia">
                    <field name="candidate_ids" nolabel="1" colspan="2">
                        <tree create="false" delete="false" editable="false">
                            <field name="lot_name" string="Lote"/>
                            <field name="qty_on_hand" string="Existencia"/>
                            <field name="reserved" string="Reservado"
                                   optional="hide"/>
                            <!-- Fuera de la vista (T9 · D-4): la disponibilidad
                                 GLOBAL engaña; la cifra que DECIDE es la del
                                 almacén de la entrega (``available_here``). -->
                            <field name="available" string="Disponible"
                                   column_invisible="True"/>
                            <field name="available_here"
                                   string="Disponible aquí"/>
                            <field name="role_label" string="Rol"/>
                            <field name="is_own_lot" column_invisible="True"/>
                            <field name="is_elective" column_invisible="True"/>
                            <field name="is_occupied" column_invisible="True"/>
                        </tree>
                    </field>
                </group>

                <!-- T12-f: la misma vía en el "Motivo" (`reason` a ancho
                     completo). Los DOS campos siguen intactos (T12-d). -->
                <group string="Motivo de la asignación">
                    <field name="reason" nolabel="1" colspan="2" required="1"
                           placeholder="¿Por qué se asigna este lote a cada unidad?"/>
                    <!-- Restituido (T10 · regresión de T4): la acción
                         ``action_assign_lot_bulk`` EXIGE este check cuando la
                         política de excepción es distinta a ``warn`` (CA-6).
                         Sin él, una política estricta deja al operador sin
                         forma de confirmar desde la UI. -->
                    <field name="confirm_exception"
                           help="La política vigente exige confirmar la excepción."/>
                </group>

                <!-- T12-b (H-050): la prosa del "Motivo" también va fuera del
                     grupo ⇒ ancho completo. Los dos campos de arriba NO se tocan
                     (T12-d). -->
                <div class="text-muted">
                    El motivo es OBLIGATORIO y queda en la bitácora de cada
                    documento. La asignación requiere jefe de
                    taller/administrador y ESCRIBE inventario por la vía NATIVA
                    (reasignación de reserva).
                </div>

                <footer>
                    <button name="action_assign_lot_bulk" type="object"
                            string="Asignar lote" class="btn-primary"
                            icon="fa-tags"
                            title="Asigna el lote elegido en CADA fila (cada fila es un movimiento de la entrega). ESCRIBE inventario por la vía NATIVA (reserva). Requiere jefe de taller/administrador"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
