<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         DIAGNÓSTICO DE PEDIDO (PrintFlow) — centro de operaciones.

         Un solo formulario que navega SIN recrear el wizard:
           1. Nivel 1         -> SELECTOR de productos terminados con demanda
                                 pendiente. Solo aparece SIN foco y con MÁS DE
                                 UNO: el auto-foco salta directo al diagrama
                                 cuando hay un único producto con demanda.
           2. Línea de tiempo -> canvas secuencial COMPLETO del producto (compra
                                 o fabricación -> recepción -> inventario ->
                                 fabricación -> preparación -> entrega -> cliente).
                                 Cada nodo es clicable y abre un POPOVER con el
                                 detalle del área y las acciones DIRECTAS.
         Se ELIMINÓ el Nivel 3 (detalle del área): su contenido se fusionó como
         panel dentro del popover del nodo. El foco es solo `focus_line_id`.
         ================================================================== -->
    <record id="printflow_order_diagnostic_wizard_view_form" model="ir.ui.view">
        <field name="name">printflow.order.diagnostic.wizard.form</field>
        <field name="model">printflow.order.diagnostic.wizard</field>
        <field name="arch" type="xml">
            <form string="Diagnóstico y Ruta de Solución">
                <!-- Campos de contexto y modificadores (todos presentes por
                     exigencia del cliente de vistas). -->
                <field name="board_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="has_deficit" invisible="1"/>
                <field name="sale_order_id" invisible="1"/>
                <field name="has_delivery_picking" invisible="1"/>
                <field name="has_purchase" invisible="1"/>
                <field name="has_production" invisible="1"/>
                <!-- Foco: solo la línea de tiempo (focus_line_id). -->
                <field name="focus_line_id" invisible="1"/>
                <field name="is_timeline" invisible="1"/>
                <!-- Selector de producto (Nivel 1): terminados con demanda
                     pendiente y banderas de UI. NO almacenados. -->
                <field name="finished_product_count" invisible="1"/>
                <field name="can_switch_product" invisible="1"/>
                <field name="show_product_selector" invisible="1"/>
                <!-- Campos del producto enfocado (related, NO almacenados). -->
                <field name="focus_product_id" invisible="1"/>
                <field name="focus_line_kind" invisible="1"/>
                <field name="focus_severity" invisible="1"/>
                <field name="focus_sale_status" invisible="1"/>
                <field name="focus_stock_status" invisible="1"/>
                <field name="focus_purchase_status" invisible="1"/>
                <field name="focus_production_status" invisible="1"/>
                <field name="focus_delivery_status" invisible="1"/>
                <field name="focus_pending_delivery_order_count" invisible="1"/>
                <field name="focus_root_cause_node" invisible="1"/>
                <field name="focus_failed_node_count" invisible="1"/>
                <field name="focus_failure_summary" invisible="1"/>
                <field name="focus_deficit_qty" invisible="1"/>
                <field name="focus_contention_qty" invisible="1"/>
                <field name="focus_incoming_qty" invisible="1"/>
                <!-- Contadores por nodo causal (badges del canvas). -->
                <field name="node_sale_issue_count" invisible="1"/>
                <field name="node_stock_issue_count" invisible="1"/>
                <field name="node_purchase_issue_count" invisible="1"/>
                <field name="node_production_issue_count" invisible="1"/>
                <field name="node_delivery_issue_count" invisible="1"/>
                <!-- Remedy de cabecera (campos de modificadores). -->
                <field name="remedy_available" invisible="1"/>
                <!-- Bloque III §28: saneamiento disponible ante reserva colgada. -->
                <field name="pf_has_stuck_reservations" invisible="1"/>
                <!-- FEATURE A: cadena de fallas (raíz -> consecuencias). -->
                <field name="focus_chain_summary" invisible="1"/>
                <field name="focus_chain_root_label" invisible="1"/>
                <field name="node_sale_is_consequence" invisible="1"/>
                <field name="node_stock_is_consequence" invisible="1"/>
                <field name="node_purchase_is_consequence" invisible="1"/>
                <field name="node_production_is_consequence" invisible="1"/>
                <field name="node_delivery_is_consequence" invisible="1"/>
                <!-- FEATURE B: falla acumulada (backlog) del pedido. -->
                <field name="pf_has_backlog" invisible="1"/>
                <sheet>
                    <!-- ===== SANEAMIENTO SIEMPRE (Bloque III §28) =====
                         Disponible aunque el tablero esté 'ok': detecta una
                         reserva colgada (quant con libre < 0) y ofrece el
                         saneamiento estructural (jefe de taller/admin).
                         F1-A: SOLO en el Nivel 1 (lista de productos). En la
                         línea de tiempo el aviso se migra al NODO de stock, que
                         lo trae como badge ámbar y acción en su popover. -->
                    <div class="alert alert-warning d-flex align-items-center flex-wrap gap-2"
                         invisible="not pf_has_stuck_reservations or is_timeline">
                        <i class="fa fa-eraser me-1"/>
                        <div class="flex-grow-1">
                            <strong>Reserva colgada:</strong> hay una reserva enganchada a una
                            ubicación sin existencia. Sanea para re-asignar por reglas de Odoo.
                        </div>
                        <button name="action_cleanup_order_reservations" type="object"
                                string="Sanear reservas colgadas" class="btn-warning btn-sm"
                                icon="fa-eraser"
                                groups="mrp.group_mrp_manager,base.group_system"
                                title="Suelta y re-asigna las reservas por reglas de Odoo (jefe de taller / administrador)"/>
                    </div>
                    <!-- ============ ENCABEZADO COMPACTO DEL PEDIDO ============ -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-stethoscope fa-lg text-primary"/>
                            <div>
                                <div class="fs-5 fw-bold lh-1">
                                    <field name="name" nolabel="1" class="d-inline"/>
                                </div>
                                <div class="text-muted small mt-1 d-flex align-items-center flex-wrap gap-1">
                                    <i class="fa fa-user-o"/>
                                    <field name="partner_id" nolabel="1"/>
                                    <div class="badge text-bg-light border ms-2 d-inline-flex align-items-center"
                                         invisible="not origin_channel">
                                        <i class="fa fa-exchange me-1"/>
                                        <field name="origin_channel" nolabel="1" class="d-inline"/>
                                    </div>
                                    <div class="badge text-bg-light border ms-2 d-inline-flex align-items-center"
                                         invisible="delivery_status == 'na'">
                                        <i class="fa fa-truck me-1"/>
                                        <field name="delivery_status" nolabel="1" class="d-inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small text-uppercase">Total</div>
                            <div class="fs-4 fw-bold text-nowrap">
                                <field name="amount_total_display" widget="monetary"
                                       options="{'field_digits': True, 'currency_field': 'currency_id'}"
                                       nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- ============ NIVEL 1: SELECTOR DE PRODUCTO ============ -->
                    <!-- Solo aparece SIN foco y con MÁS DE UN producto con demanda
                         pendiente. Con un único producto el auto-foco salta
                         directo al diagrama y este bloque no se muestra. -->
                    <div invisible="focus_line_id or finished_product_count &lt;= 1">
                        <div class="text-uppercase text-muted fw-bold small mb-1">
                            Elige el producto a diagnosticar
                        </div>
                        <field name="product_line_ids" nolabel="1">
                            <tree create="false" delete="false" editable="false">
                                <field name="product_id" string="Producto"
                                       widget="printflow_open_timeline"/>
                                <field name="status_note" string="Qué pasa"/>
                                <field name="deficit_qty" string="Falta física"
                                       widget="float" options="{'digits': [16, 2]}"
                                       sum="Total falta física"/>
                                <field name="contention_qty" string="Contención"
                                       widget="float" options="{'digits': [16, 2]}"
                                       sum="Total contención"/>
                                <field name="incoming_qty" string="En camino"
                                       widget="float" options="{'digits': [16, 2]}"
                                       sum="Total en camino"/>
                                <field name="uom_id" string="UdM" optional="hide"/>
                                <field name="warehouse_free_qty" string="Libre para el pedido"
                                       widget="float" options="{'digits': [16, 2]}"
                                       optional="hide"/>
                            </tree>
                        </field>
                    </div>

                    <!-- ============== NIVEL 2: LÍNEA DE TIEMPO ============== -->
                    <div invisible="not is_timeline">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <button name="action_scan_product" type="object"
                                    string="Diagnosticar producto" class="btn-secondary"
                                    icon="fa-stethoscope"
                                    title="Abrir el escáner de diagnóstico del producto"/>
                            <!-- El botón vuelve al SELECTOR solo si hay más de
                                 un producto con demanda pendiente: con uno solo
                                 el auto-foco saltó directo al diagrama y no hay
                                 a dónde "volver". -->
                            <button name="action_back_to_products" type="object"
                                    string="◂ Volver a productos" class="btn-link"
                                    invisible="finished_product_count &lt;= 1"/>
                        </div>
                        <div class="text-uppercase text-muted fw-bold small mb-1">
                            <field name="focus_product_id" nolabel="1" class="d-inline"/>
                        </div>
                        <!-- DIAGRAMA DE LÍNEA DE TIEMPO (widget OWL):
                             canvas secuencial COMPLETO del producto (compra o
                             fabricación -> recepción -> inventario/fabricación ->
                             preparación -> entrega -> cliente). Cada nodo es
                             clicable y abre un POPOVER con el detalle del área
                             (panel) y las acciones DIRECTAS. El payload lo
                             serializa el campo `focus_timeline_json`. -->
                        <field name="focus_timeline_json"
                               widget="printflow_order_timeline" nolabel="1"/>
                        <!-- Leyenda de colores y conectores del diagrama. -->
                        <div class="o_pf_timeline_legend d-flex flex-wrap align-items-center gap-3 small text-muted mb-2">
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_dot tone-ok"/> Sano
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_dot tone-warn"/> Atención
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_dot tone-danger"/> Crítico
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_dot tone-na"/> Sin dato / N/A
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <i class="fa fa-long-arrow-right text-danger"/> Raíz → consecuencia
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_ring"/> Raíz
                            </span>
                            <span class="o_pf_timeline_legend_item">
                                <span class="o_pf_legend_dashed"/> Independiente
                            </span>
                        </div>
                        <!-- FEATURE A: franja de la CADENA DE FALLAS del
                             producto enfocado (raíz -> consecuencias). -->
                        <div class="alert alert-light border d-flex align-items-center flex-wrap gap-2 mb-2"
                             invisible="not focus_chain_summary">
                            <i class="fa fa-link me-1"/>
                            <strong>Cadena de fallas:</strong>
                            <field name="focus_chain_summary" nolabel="1" class="d-inline"/>
                        </div>
                        <!-- NOTA: la tabla "Fallas del producto" se ELIMINÓ. Sus
                             botones (Ver el problema / Solucionar / Alternativa)
                             y el detalle de cada falla viven ahora en el PANEL
                             del popover de CADA NODO del diagrama, y las fallas
                             de otros componentes/venta se cuelgan de su nodo
                             anfitrión (chip "+N de componentes/venta"). -->
                    </div>
                </sheet>
                <footer>
                    <button name="action_recalculate" type="object" string="Recalcular"
                            class="btn-secondary" icon="fa-refresh"
                            title="Volver a calcular el diagnóstico con el stock actual"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
