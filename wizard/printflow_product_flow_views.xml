<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         DIAGRAMA DE FLUJO DEL PRODUCTO (Fase 5)
         Form de SOLO LECTURA que pinta el MISMO widget del diagnóstico de
         pedido (``printflow_order_timeline``) a partir de ``timeline_json``.
         No hay JS nuevo: el widget ya está en ``web.assets_backend``.
         ================================================================== -->
    <record id="printflow_product_flow_view_form" model="ir.ui.view">
        <field name="name">printflow.product.flow.form</field>
        <field name="model">printflow.product.flow</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <!-- "Recalcular" (paridad de UX): el diagrama SIEMPRE abre a
                     pantalla completa (``target='current'``), y el <footer>
                     solo se pinta en diálogo; por eso el botón vive en el
                     <header> (``o_form_statusbar``), igual que el escáner de
                     producto. Fuerza el recómputo (solo lectura) y recarga el
                     MISMO wizard: sin cerrar y reabrir para ver datos frescos. -->
                <header>
                    <button name="action_recalculate" type="object"
                            string="Recalcular" class="btn-secondary"
                            icon="fa-refresh"
                            title="Volver a calcular el diagnóstico con los datos actuales"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product" type="object"
                                class="oe_stat_button" icon="fa-cube"
                                title="Abrir la ficha del producto">
                            <span class="o_stat_text">Producto</span>
                        </button>
                    </div>
                    <h1>
                        <field name="product_id" options="{'no_open': True}"
                               readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="flow_type" widget="badge"/>
                            <field name="severity" widget="badge"/>
                        </group>
                        <group>
                            <field name="root_cause_node"/>
                        </group>
                    </group>
                    <field name="timeline_json" widget="printflow_order_timeline"
                           nolabel="1"/>
                    <!-- Leyenda de colores y conectores del diagrama. Usa las
                         MISMAS clases SCSS del pedido (genéricas, sin CSS nuevo):
                         sano/atención/crítico/sin dato, raíz → consecuencia,
                         raíz e independiente. -->
                    <div class="o_pf_timeline_legend d-flex flex-wrap align-items-center gap-3 small text-muted mb-2">
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_dot tone-ok"/> Sano
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_dot tone-warn"/> Atención
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_dot tone-danger"/> Crítico
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_dot tone-na"/> Sin dato / N/A
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <i class="fa fa-long-arrow-right text-danger"/> Raíz → consecuencia
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_ring"/> Raíz
                        </span>
                        <span class="o_pf_timeline_legend_item">
                            <span class="o_pf_legend_dashed"/> Independiente
                        </span>
                    </div>
                    <!-- Franja de la CADENA DE FALLAS del producto (raíz ->
                         consecuencias), igual que en el diagrama del pedido. -->
                    <div class="alert alert-light border d-flex align-items-center flex-wrap gap-2 mb-2"
                         invisible="not chain_summary">
                        <i class="fa fa-link me-1"/>
                        <strong>Cadena de fallas:</strong>
                        <field name="chain_summary" nolabel="1" class="d-inline"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
