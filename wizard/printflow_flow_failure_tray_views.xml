<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         BANDEJA GENÉRICA DE FALLAS GUIADAS (PrintFlow · Fase 1)
         Superficie ÚNICA que pinta cualquier falla del diagrama: la cabecera
         (severidad/resumen/pasos) + UNA fila por EVIDENCIA + las ACCIONES
         guiadas por fila. La falla concreta (resuelta por
         `printflow.flow.failure.registry`) es la que DECLARA todo; la bandeja
         no conoce ninguna falla en particular.
         ================================================================== -->

    <!-- ── Tree de LÍNEAS de evidencia (embebido en el form del tray) ── -->
    <record id="printflow_flow_failure_tray_line_view_tree" model="ir.ui.view">
        <field name="name">printflow.flow.failure.tray.line.tree</field>
        <field name="model">printflow.flow.failure.tray.line</field>
        <field name="arch" type="xml">
            <tree string="Evidencias" create="false" delete="false" edit="false">
                <field name="sequence" column_invisible="True"/>
                <field name="res_model" column_invisible="True"/>
                <field name="res_id" column_invisible="True"/>
                <field name="product_id" optional="hide"/>
                <field name="lot_name" string="Lote" optional="show"/>
                <field name="location_id" string="Ubicación" optional="show"/>
                <field name="physical_qty" string="Físico" optional="show"/>
                <field name="reserved_qty" string="Reservado" optional="show"/>
                <field name="support_qty" string="Respaldo" optional="show"/>
                <field name="delta_qty" string="Delta" optional="show"/>
                <field name="support_label" string="Lo respalda" optional="show"/>
                <button name="action_open" type="object" string="Gestionar"
                        icon="fa-wrench" class="btn-link"
                        title="Ver el detalle de la evidencia y sus acciones guiadas"/>
            </tree>
        </field>
    </record>

    <!-- ── Tree de ACCIONES guiadas (embebido en el form de la línea) ── -->
    <record id="printflow_flow_failure_tray_action_view_tree" model="ir.ui.view">
        <field name="name">printflow.flow.failure.tray.action.tree</field>
        <field name="model">printflow.flow.failure.tray.action</field>
        <field name="arch" type="xml">
            <tree string="Acciones" create="false" delete="false" edit="false">
                <field name="sequence" column_invisible="True"/>
                <field name="key" column_invisible="True"/>
                <field name="kind" column_invisible="True"/>
                <field name="enabled" column_invisible="True"/>
                <field name="primary" column_invisible="True"/>
                <field name="label" string="Acción"/>
                <button name="action_run" type="object" string="Ejecutar"
                        icon="fa-play" class="btn-link"
                        invisible="not enabled or kind == 'navigate' or kind == 'close'"
                        title="Ejecutar esta corrección (pasa por el guardia de permisos de la falla)"/>
                <button name="action_run" type="object" string="Abrir"
                        icon="fa-external-link" class="btn-link"
                        invisible="kind != 'navigate'"
                        title="Abrir el registro/lista señalada (solo navegación)"/>
                <button name="action_run" type="object" string="Cerrar"
                        icon="fa-times" class="btn-link"
                        invisible="kind != 'close'"
                        title="Cerrar la bandeja"/>
            </tree>
        </field>
    </record>

    <!-- ── Form de la LÍNEA de evidencia (diálogo con sus acciones) ── -->
    <record id="printflow_flow_failure_tray_line_view_form" model="ir.ui.view">
        <field name="name">printflow.flow.failure.tray.line.form</field>
        <field name="model">printflow.flow.failure.tray.line</field>
        <field name="arch" type="xml">
            <form string="Evidencia" create="false" edit="false" delete="false">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <sheet>
                    <group>
                        <group string="Afectado">
                            <field name="product_id"/>
                            <field name="lot_name"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Cantidades">
                            <field name="physical_qty"/>
                            <field name="reserved_qty"/>
                            <field name="support_qty"/>
                            <field name="delta_qty"/>
                            <field name="support_label"/>
                        </group>
                    </group>
                    <group string="Detalle" col="1">
                        <field name="detail" nolabel="1"/>
                    </group>
                    <separator string="Acciones guiadas"/>
                    <field name="action_ids">
                        <tree create="false" delete="false" edit="false">
                            <field name="sequence" column_invisible="True"/>
                            <field name="key" column_invisible="True"/>
                            <field name="kind" column_invisible="True"/>
                            <field name="enabled" column_invisible="True"/>
                            <field name="primary" column_invisible="True"/>
                            <field name="label" string="Acción"/>
                            <button name="action_run" type="object" string="Ejecutar"
                                    icon="fa-play" class="btn-link"
                                    invisible="not enabled or kind == 'navigate' or kind == 'close'"/>
                            <button name="action_run" type="object" string="Abrir"
                                    icon="fa-external-link" class="btn-link"
                                    invisible="kind != 'navigate'"/>
                            <button name="action_run" type="object" string="Cerrar"
                                    icon="fa-times" class="btn-link"
                                    invisible="kind != 'close'"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Form del TRAY (cabecera/contexto + evidencias) ── -->
    <record id="printflow_flow_failure_tray_view_form" model="ir.ui.view">
        <field name="name">printflow.flow.failure.tray.form</field>
        <field name="model">printflow.flow.failure.tray</field>
        <field name="arch" type="xml">
            <form string="Bandeja de fallas" create="false" edit="false"
                  delete="false">
                <header>
                    <button name="action_close" type="object" string="Cerrar"
                            class="btn-secondary" icon="fa-times"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="summary" nolabel="1"/></h1>
                    </div>
                    <group>
                        <group string="Hallazgo">
                            <field name="code"/>
                            <field name="product_id"/>
                            <field name="severity" widget="badge"/>
                        </group>
                        <group string="Origen">
                            <field name="host_model"/>
                            <field name="host_res_id"/>
                        </group>
                    </group>
                    <group string="Cómo resolverlo" col="1">
                        <field name="steps" nolabel="1"/>
                    </group>
                    <separator string="Evidencias"/>
                    <field name="line_ids">
                        <kanban create="false" delete="false" edit="false"
                                quick_create="false" group_create="false">
                            <field name="sequence"/>
                            <field name="primary_label"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="product_id"/>
                            <field name="lot_name"/>
                            <field name="location_id"/>
                            <field name="support_label"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_card">
                                        <div class="o_kanban_record_top">
                                            <strong class="o_kanban_record_title">
                                                <field name="lot_name"/>
                                            </strong>
                                            <field name="location_id"/>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <div>
                                                <span class="text-muted">Físico</span>
                                                <field name="physical_qty"/>
                                                <span class="text-muted ms-2">Reservado</span>
                                                <field name="reserved_qty"/>
                                            </div>
                                            <div>
                                                <span class="text-muted">Respaldo</span>
                                                <field name="support_qty"/>
                                                <span class="text-muted ms-2">Delta</span>
                                                <field name="delta_qty"/>
                                            </div>
                                            <div><field name="support_label"/></div>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <button name="action_run_primary"
                                                        type="object"
                                                        class="btn btn-primary"
                                                        invisible="not primary_label"
                                                        title="Ejecutar la acción principal de esta evidencia">
                                                    <span t-esc="record.primary_label.value"/>
                                                </button>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <button name="action_open"
                                                        type="object"
                                                        class="btn btn-link"
                                                        icon="fa-wrench"
                                                        title="Ver el detalle y las acciones de navegación"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción de ventana + menú (acceso de consulta a las bandejas) ── -->
    <record id="action_printflow_flow_failure_tray" model="ir.actions.act_window">
        <field name="name">Bandejas de fallas</field>
        <field name="res_model">printflow.flow.failure.tray</field>
        <field name="view_mode">form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Las bandejas de fallas se abren desde el diagrama.
            </p>
            <p>
                Esta superficie guía la corrección de una falla detectada en el
                diagrama de flujo: una fila por evidencia y una acción por fila.
            </p>
        </field>
    </record>

    <menuitem id="menu_printflow_flow_failure_tray"
              parent="menu_printflow_health_app"
              action="action_printflow_flow_failure_tray"
              sequence="90"/>

</odoo>
