<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regla GLOBAL de compañía: cada usuario solo ve/usa las excepciones
         formales de sus compañías (y las sin compañía, por compatibilidad). El
         adaptador de filtrado (``printflow.finding.exception.filter``) consulta
         con ``sudo()`` y filtra explícitamente por la compañía actual, así que
         esta regla solo acota la superficie de gestión (lista/form). -->
    <record id="rule_printflow_finding_exception_company" model="ir.rule">
        <field name="name">printflow.finding.exception: por compañía</field>
        <field name="model_id" ref="model_printflow_finding_exception"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
